# Office — instance config. Copy to `.env` and fill in; `.env` is gitignored.
# Everything the app needs that is specific to your machine/identity lives here,
# so the code itself carries no personal or host details.

OFFICE_TITLE="Office"          # shown in the header and the browser tab
OFFICE_EMAIL=""                # optional; shown on the status page
OFFICE_TAILNET_HOST=""         # optional; auto-detected from `tailscale status` if empty.
                               # Comma-separate to allow extra names a reverse proxy serves the app under.

# Header links — leave a value empty to hide that link:
# OFFICE_STATUS_URL="/status/"  # the built-in usage/limits dashboard
# OFFICE_SWITCH_BIN="claude-switch"  # account switcher behind the header's account pill (json / --yes <email>)
# OFFICE_FILES_URL=""           # a file browser, e.g. a dufs mount served at /dufs/
# OFFICE_SECRETARY_NAME="Secretary"   # display name for the dispatcher panel
# OFFICE_SECRETARY_MODEL="sonnet"  # model she answers you with (kept open; uses the `claude` CLI)
# OFFICE_ELEVENLABS_KEY=""        # the secretary speaks "What's new" (ElevenLabs); off when empty
# OFFICE_SECRETARY_VOICE=""       # ElevenLabs voice id
# OFFICE_TTS_MODEL="eleven_multilingual_v2"
# OFFICE_BRIEF_LANGUAGE="Egyptian Arabic (colloquial, as spoken in Cairo)"
# OFFICE_BRIEF_OPENER="{name}، خليني أشوف أخبار الشباب إيه في مكتب حضرتك."
# OFFICE_ASK_OPENER="ثانية واحدة {name}"   # said the moment you ask her something
# OFFICE_OPERATOR_NAME=""         # what she calls you
# OFFICE_OPERATOR_GENDER=""       # man / woman: how she speaks to you
# OFFICE_BRIEF_MODEL="sonnet"     # model that words the briefing

# Demo mode — serve the fictional team in demo.json instead of reading live tmux.
# Great for screenshots, talks, or trying it out. "1" uses demo.json; or give a path.
# OFFICE_DEMO="1"

# Phone notifications — the iPhone app (ios/) shows "X needs you" when a session asks you something,
# is done or is gone; a tap opens that terminal. Sent through Apple's push service with your APNs key
# (developer.apple.com → Keys → + → Apple Push Notifications service). Empty = off.
# OFFICE_APNS_KEY="/path/to/AuthKey_XXXXXXXXXX.p8"   # keep it out of git
# OFFICE_APNS_KEY_ID=""                              # the key's 10-character id
# OFFICE_APNS_TEAM_ID=""                             # your team's 10-character id
# OFFICE_APNS_TOPIC="com.pyinv.office"               # the app's bundle id, if you changed it
# OFFICE_PUSH_EVENTS="waiting,review,secretary,gone"  # needs you / is done / secretary follow-ups / session gone

# Optional overrides (sensible defaults are derived from $HOME):
# OFFICE_DEV_ROOT="$HOME/develop"   # where "+ New" may create project folders
# OFFICE_CLAUDE_BIN=""              # defaults to `which claude`
# OFFICE_PORT="8899"
